{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<div class="container d-flex justify-content-center align-items-center" style="min-height:70vh;">
    <div class="card p-4 shadow-sm" style="width:350px;">
        <h3 class="text-center mb-4">Mot de passe oublié</h3>

        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
        {% endfor %}

        <p class="text-muted small text-center mb-3">
            Entrez votre email, nous vous enverrons un lien pour réinitialiser votre mot de passe.
        </p>

        {{ form_start(requestForm) }}
            <div class="mb-3">
                {{ form_label(requestForm.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(requestForm.email, {'attr': {'class': 'form-control'}}) }}
            </div>

            <button class="btn btn-primary w-100" type="submit">Envoyer le lien de réinitialisation</button>
        {{ form_end(requestForm) }}

        <div class="text-center mt-3">
            <a href="{{ path('app_login') }}">Retour à la connexion</a>
        </div>
    </div>
</div>
{% endblock %}