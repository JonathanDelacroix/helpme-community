{% extends 'base.html.twig' %}

{% block title %}Administration{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Administration</h1>
            <p class="text-muted mb-0">Gestion des actions (projets), des dons et des comptes utilisateurs.</p>
        </div>
        <a href="{{ path('admin_project_new') }}" class="btn btn-primary">Nouvelle action</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Actions</div>
                    <div class="display-6">{{ projects|length }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Dons</div>
                    <div class="display-6">{{ donations|length }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Total collecté</div>
                    <div class="display-6">{{ totalDonations|number_format(2, ',', ' ') }} EUR</div>
                </div>
            </div>
        </div>
    </div>

    <section class="mb-5">
        <h2 class="h4 mb-3">Actions / projets</h2>
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Titre</th>
                                <th>Type</th>
                                <th>Image</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for project in projects %}
                                <tr>
                                    <td>{{ project.title }}</td>
                                    <td>{{ project.slug }}</td>
                                    <td>{{ project.image|default('Aucune') }}</td>
                                    <td class="text-end">
                                        <a href="{{ path('project_show', {slug: project.slug}) }}" class="btn btn-sm btn-outline-secondary">Voir</a>
                                        <a href="{{ path('admin_project_edit', {id: project.id}) }}" class="btn btn-sm btn-primary">Modifier</a>
                                        <form method="post" action="{{ path('admin_project_delete', {id: project.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cette action ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_project_' ~ project.id) }}">
                                            <button class="btn btn-sm btn-outline-danger">Supprimer</button>
                                        </form>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-muted">Aucune action créée.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <section class="mb-5">
        <h2 class="h4 mb-3">Dons reçus</h2>
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Référence</th>
                                <th>Donateur</th>
                                <th>Email</th>
                                <th>Type</th>
                                <th>Montant</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for donation in donations %}
                                <tr>
                                    <td>#{{ donation.id }}</td>
                                    <td>{{ donation.firstName }} {{ donation.lastName }}</td>
                                    <td>{{ donation.email }}</td>
                                    <td>{{ donation.type }}</td>
                                    <td>{{ donation.amount|number_format(2, ',', ' ') }} EUR</td>
                                    <td>
                                        {% if donation.isPaid %}
                                            <span class="badge bg-success">Payé</span>
                                        {% elseif donation.status == 'cancelled' %}
                                            <span class="badge bg-danger">Annulé</span>
                                        {% else %}
                                            <span class="badge bg-warning text-dark">En attente</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="text-muted">Aucun don pour le moment.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <section>
        <h2 class="h4 mb-3">Utilisateurs</h2>
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th>Roles</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in users %}
                                <tr>
                                    <td>{{ user.email }}</td>
                                    <td>{{ user.roles|join(', ') }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="2" class="text-muted">Aucun utilisateur.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>
{% endblock %}
