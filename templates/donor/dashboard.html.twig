{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1>Bienvenue {{ app.user.email }}</h1>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <h2 class="mb-0">Mes dons</h2>
        <a href="{{ path('donation') }}" class="btn btn-primary">Faire un nouveau don</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Référence</th>
                            <th>Type</th>
                            <th>Montant</th>
                            <th>Statut</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for donation in donations %}
                            <tr>
                                <td>#{{ donation.id }}</td>
                                <td>{{ donation.type|default('Non precisé') }}</td>
                                <td>{{ donation.amount|number_format(2, ',', ' ') }} EUR</td>
                                <td>
                                    {% if donation.isPaid %}
                                        <span class="badge bg-success">Payé</span>
                                    {% elseif donation.status == 'cancelled' %}
                                        <span class="badge bg-danger">Annulé</span>
                                    {% else %}
                                        <span class="badge bg-warning text-dark">En attente</span>
                                    {% endif %}
                                </td>
                                <td>{{ donation.email|default(app.user.email) }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-muted">Vous n'avez pas encore fait de don.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
